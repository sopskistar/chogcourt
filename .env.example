# Local HTTP preview. In production set the exact HTTPS origin and NODE_ENV.
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=http://127.0.0.1:4173
NODE_ENV=development
# Must be on a persistent disk/volume. Never use ephemeral serverless storage.
DATABASE_PATH=./data/chogcourt.sqlite
# Community court rules, recorded per case. These are not token thresholds.
JURY_POLICY=account
MIN_QUORUM=3
EVIDENCE_SECONDS=86400
VOTING_SECONDS=86400
# Empty allows public registration; provide an invitation code for a closed court.
REGISTRATION_CODE=
# Reserved/unused: Genesis collection and chain are allowlisted in server/wallet.mjs.
# Signed NFT identity works; NFT-gated voting and $CHOG nominations remain disabled.
NFT_COLLECTION_ADDRESS=
CHOG_MIN_BALANCE=
# Optional server-only read-only RPC. Public default needs no API key.
# Used for real Genesis ownership observations, not token transfers or approvals.
MONAD_RPC_URL=https://rpc.monad.xyz
# Vercel + Neon production only: configure DATABASE_URL in Vercel's encrypted
# Environment Variables; never paste the Neon connection string into this file.
# DATABASE_URL=
